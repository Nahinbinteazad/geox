# Copy to .env and fill in. Never commit the real file.

# Verifies the access token the Flutter app sends.
# Supabase dashboard -> Project settings -> API -> JWT Secret
# WITHOUT THIS, TOKENS ARE READ BUT NOT VERIFIED AND EVERY PROTECTED ROUTE IS OPEN.
# /health says so. Set it before anyone else can reach the service.
SUPABASE_JWT_SECRET=

# Optional. Point at the full 600-site file from the Kaggle dataset for results
# that match the shipped rankings exactly. Without it the service falls back to
# the 89 sites bundled in geox_data.json and says so in every response.
EARTH_CSV=app/earth_candidates.csv

# Optional overrides
GEOX_DATA=app/geox_data.json
GEOX_DB=app/geox.sqlite3
CORS_ORIGINS=*
